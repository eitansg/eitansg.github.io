# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore LaTeX auxiliary files
files/*.aux
files/*.log
files/*.out
files/*.synctex.gz
files/*.fls
files/*.fdb_latexmk

# Ignore the job-market CV (kept local, never published or committed)
files/cv_jm.tex
files/eitan_cv_jm.pdf

# Ignore application statements (kept local for now)
files/statement.sty
files/ts_overleaf.pdf
files/cover_letter*.tex
files/cover_letter*.pdf
files/*_statement*.tex
files/*_statement*.pdf

# Ignore folders related to IDEs
.vscode/
