# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file at root level and bundle for alternative installation
/vendor/
.bundle/

# Ignore LaTeX auxiliary files
files/**/*.aux
files/**/*.log
files/**/*.out
files/**/*.synctex.gz
files/**/*.fls
files/**/*.fdb_latexmk

# Ignore everything under files/jm/ --- job market materials (statements,
# cover letter, job market CV, shared preamble) are kept local and must never
# reach the public site. Published papers live in files/papers/ and the public
# CV in files/cv/.
files/jm/

# Ignore folders related to IDEs
.vscode/
